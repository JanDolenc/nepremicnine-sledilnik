# Variables have default or placeholder values

# DOCKER COMPOSE FOR CRAWLER
# --------------------------
CRAWLER_IMAGE=nsledilnik/crawler:py3.11.3-alpine
FLARESOLVERR_VERSION=v3.2.0


# DATABASE CREDENTIALS
# --------------------
MYSQL_ROOT_PASSWORD=ververystrongpswd
DB_USER1=db_user_1
DB_USER1_PASSWORD=db_user_1_pswrd
DB_USER2=db_user_2
DB_USER2_PASSWORD=db_user_2_pswrd


# CONNECTING TO DATABASE
# ----------------------
DATABASE_USER=user
DATABASE_PASSWORD=my_secret
DATABASE_HOST=127.0.0.1 # or name of the database docker container
DATABASE_PORT=3306
DATABASE_NAME=db_dev


# IMPORTER
# --------
IMPORT_FOLDER_PATH=/path/to/folder/with/json/files/for/import/
ARCHIVE_FOLDER_PATH=/path/to/folder/where/importer/should/put/files/after/successful/import/


# MAIN (ROOT) DOCKER COMPOSE
# --------------------------
REVERSE_PROXY_IMAGE=traefik:v3.2
FRONTEND_IMAGE=nsledilnik/frontend:tag
API_IMAGE=nsledilnik/api:tag
DATABASE_IMAGE=nsledilnik/database:tag

# Strongly recommend binding the port to localhost like this: "127.0.0.1:3306". Then the service (db) is accessible only thru localhost.
HOST_DB_PORT=3306 

# Mail associated with the certificate
CERT_MAIL=<mail@example.com>

# IMPORTANT! For hashing the password use utility "htpasswd".
# After you successfully hashed the password you need to double every dollar sign to escape it, if you don't the password won't work. See Traefik docs/basicAuth. 
TRAEFIK_USER_PASSWORD_HASH=test-user:<hashed-password-here> # Example test:$$apr1$$d9hr9HBB$$4HxwgUir3HP4EsggP/QNo0 

# UMAMI ANALYTICS
UMAMI_IMAGE=ghcr.io/umami-software/umami:postgresql-latest
UMAMI_APP_SECRET=<random-string> # generate it with: `openssl rand -base64 32`
UMAMI_PG_DATABASE=umami
UMAMI_PG_USER=umami
UMAMI_PG_PASSWORD=umami