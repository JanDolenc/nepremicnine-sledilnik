# docker compose for crawler
CRAWLER_IMAGE=nsledilnik/crawler:py3.11.3-alpine
FLARESOLVERR_VERSION=v3.2.0

# database
DATABASE_USER=user
DATABASE_PASSWORD=my_secret 
DATABASE_HOST=127.0.0.1 # or name of the docker container
DATABASE_PORT=3306 # mysql default is 3306
DATABASE_NAME=db_dev

# importer
IMPORT_FOLDER_PATH=/path/to/folder/with/json/files/for/import/
ARCHIVE_FOLDER_PATH=/path/to/folder/where/importer/should/put/files/after/successful/import/

# Makefile database
BIND_FOLDER_HOST=$$(pwd)/import-data
BIND_FOLDER_CONTAINER=/usr/src/importer/import-data
ENV_FILE=../.env
IMPORTER_LOG=../logs/importer/importer-job-$$(date +"%y-%m-%d__%H-%M-%S").log
